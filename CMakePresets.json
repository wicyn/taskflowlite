{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "TFL_BUILD_TESTS": "ON",
        "TFL_BUILD_EXAMPLES": "ON",
        "TFL_BUILD_BENCHMARKS": "OFF",
        "TFL_SANITIZER": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "TFL_SANITIZER": "ASAN"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "TFL_SANITIZER": "TSAN"
      }
    },
    {
      "name": "benchmarks",
      "inherits": "release",
      "cacheVariables": {
        "TFL_BUILD_EXAMPLES": "OFF",
        "TFL_BUILD_BENCHMARKS": "ON",
        "TFL_NATIVE_ARCH": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-asan",
      "inherits": "windows-release",
      "cacheVariables": {
        "TFL_SANITIZER": "ASAN"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "targets": [
        "bench_taskflowlite",
        "bench_taskflow"
      ]
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "benchmark"
        }
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
